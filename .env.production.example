# Use image tags from one successful public FLYT build, or pin both by digest.
FLYT_BACKEND_IMAGE=ghcr.io/chalvin96/flyt-backend:sha-REPLACE
FLYT_FRONTEND_IMAGE=ghcr.io/chalvin96/flyt-frontend:sha-REPLACE
# Hexadecimal avoids URL escaping in the database connection string.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
ENV=production
SECRET_KEY=replace-with-an-independent-random-secret-at-least-32-characters
ADMIN_SESSION_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
OAUTH_SESSION_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
PROVIDER_CREDENTIAL_ENCRYPTION_KEYS='["replace-with-a-generated-fernet-key"]'
ACCESS_COOKIE_SECURE=true
ACCESS_COOKIE_SAMESITE=lax
FRONTEND_ORIGINS='["https://flyt.umebocchi.my.id","https://api.flyt.umebocchi.my.id"]'
FRONTEND_LOGIN_SUCCESS_URL=https://flyt.umebocchi.my.id/home
FRONTEND_LOGIN_FAILURE_URL=https://flyt.umebocchi.my.id/login
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://api.flyt.umebocchi.my.id/users/oauth/google/callback
# Launch without funded model calls; enable them after configuring the provider.
STORY_GENERATION_ENABLED_PROVIDERS='[]'
CHATBOT_ENABLED_MODELS='[]'
CHATGPT_LINK_ENABLED=false
METRICS_ENABLED=false
LOG_FORMAT=json
# Replace with the reverse proxy's actual addresses/networks. Never use '*'.
FORWARDED_ALLOW_IPS=127.0.0.1
# Loopback ports for a reverse proxy on the host. Coolify routes to the
# backend:8000 and frontend:8080 containers on its managed proxy network.
FLYT_API_BIND=127.0.0.1:8000
FLYT_WEB_BIND=127.0.0.1:8080
