{
  "version": "0.9.13",
  "scan_args": [
    "--no-dead-code",
    "--no-supply-chain"
  ],
  "max_errors": 0,
  "max_warnings_by_rule": {
    "exhaustive-deps": 0,
    "js-combine-iterations": 0,
    "js-flatmap-filter": 0,
    "no-adjust-state-on-prop-change": 0,
    "no-array-index-as-key": 0,
    "no-cascading-set-state": 0,
    "no-effect-chain": 0,
    "no-effect-event-handler": 0,
    "no-giant-component": 0,
    "no-high-complexity-react-function": 0,
    "no-many-boolean-props": 0,
    "no-pass-live-state-to-parent": 0,
    "no-placeholder-only-field": 0,
    "no-prop-callback-in-effect": 0,
    "no-reset-all-state-on-prop-change": 0,
    "no-spread-accumulator-in-reduce": 0,
    "no-transition-all": 0,
    "only-export-components": 0,
    "prefer-html-dialog": 0,
    "prefer-tag-over-role": 0,
    "use-lazy-motion": 0
  }
}
