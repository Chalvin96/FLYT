# Database URL (PostgreSQL)
ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/change-me
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/test_db

# Frontend origins allowed by CORS (JSON array string)
# FRONTEND_ORIGINS=["http://localhost:5173"]

# Auth and cookie settings
# Required: set a stable value to keep existing tokens valid across restarts
SECRET_KEY=replace-with-a-long-random-secret
# Required: generate independently from SECRET_KEY; signs admin session cookies
ADMIN_SESSION_SECRET=replace-with-a-long-random-admin-secret
# ACCESS_TOKEN_EXPIRE_HOURS=24
# ACCESS_COOKIE_NAME=access_token
# ACCESS_COOKIE_SECURE=false
# ACCESS_COOKIE_SAMESITE=lax
# ACCESS_COOKIE_DOMAIN=
# ACCESS_COOKIE_PATH=/

# Google OAuth (get credentials from Google Cloud Console)
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/users/oauth/google/callback
# FRONTEND_LOGIN_SUCCESS_URL=http://localhost:5173/home
# FRONTEND_LOGIN_FAILURE_URL=http://localhost:5173/login
OAUTH_SESSION_SECRET=replace-with-a-random-secret

# Internal CPU speech-to-text service; leave unset when speech is not deployed
# STT_SVC_URL=http://flyt-stt:8080
# STT_SVC_TIMEOUT_SECONDS=30
# STT_MAX_AUDIO_BYTES=10485760
# STT_PROXY_MAX_CONCURRENCY=4
# STT_PROXY_MAX_REQUESTS_PER_USER=6
# STT_PROXY_RATE_WINDOW_SECONDS=60

# Provider credentials
# Required, no default: ordered Fernet keys; the first encrypts, all decrypt (rotation = prepend).
# Generate each with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Must be set in the deployment environment (Coolify) BEFORE deploy — a missing or malformed value fails boot for the whole app.
PROVIDER_CREDENTIAL_ENCRYPTION_KEYS=["replace-with-a-generated-fernet-key"]

# ChatGPT account linking
# Operator kill switch for the whole linking surface; takes effect on restart
# CHATGPT_LINK_ENABLED=true
# CHATGPT_DEFAULT_MODEL=gpt-5.6-luna
# CHATGPT_MODELS=["gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol"]

# Chatbot model transport
# The direct GLM and DeepSeek choices use a learner-supplied OpenRouter key.
# The shared provider keyring encrypts that key at rest.
# CHATBOT_ENABLED_MODELS=["flyt", "chatgpt", "deepseek", "glm"]
# CHATBOT_MAX_OUTPUT_TOKENS=2000
# CHATBOT_FLYT_MODEL=z-ai/glm-5.3-flash
# CHATBOT_GLM_MODEL=z-ai/glm-5.3-flash
# CHATBOT_DEEPSEEK_MODEL=deepseek/deepseek-v4-flash-0731
# CHATBOT_OPENROUTER_REASONING_EFFORT=low

# Shared weekly Flyt token stock for service-funded chatbot and story calls
# FLYT_AI_WEEKLY_TOKEN_BUDGET=100000
# Shared provider token budget and fixed UTC window for Flyt story generation
# STORY_GENERATION_AGGREGATE_TOKEN_BUDGET=10000000
# STORY_GENERATION_AGGREGATE_WINDOW_HOURS=24

# Story generation; required while the default openrouter provider is enabled
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
# STORY_GENERATION_ENABLED_PROVIDERS=["openrouter"]
