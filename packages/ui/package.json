{
  "name": "@flyt/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:tokens": "node --test scripts/penpot-tokens.test.mjs",
    "test:components": "node --test scripts/penpot-components.test.mjs",
    "tokens:generate": "node scripts/penpot-tokens.mjs --output penpot-tokens.json && pnpm --filter frontend exec prettier --write ../packages/ui/penpot-tokens.json",
    "components:generate": "node scripts/penpot-components.mjs --output penpot-components.json && pnpm --filter frontend exec prettier --write ../packages/ui/penpot-components.json",
    "type-check": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./sonner": "./src/components/sonner.tsx",
    "./postcss/*": "./postcss/*.mjs",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/entry.css": "./src/styles/entry.css",
    "./styles/shadow-surface.css": "./src/styles/shadow-surface.css"
  },
  "peerDependencies": {
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "next-themes": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "postcss": "^8.5.31",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@csstools/css-color-parser": "4.2.6",
    "@csstools/css-parser-algorithms": "4.0.2",
    "@csstools/css-tokenizer": "4.0.2",
    "@storybook/react": "^10.6.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
